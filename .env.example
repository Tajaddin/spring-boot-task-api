# Copy to .env and adjust for your environment. Do NOT commit .env.
# The docker-compose.yml falls back to "taskapi" for local dev if these are unset.
POSTGRES_PASSWORD=taskapi
DATABASE_PASSWORD=taskapi

# JWT signing secret. The compose default below is for local dev ONLY.
# In production you MUST set APP_JWT_SECRET to a real, high-entropy value.
APP_JWT_SECRET=dGhpcy1pcy1hLWRldmVsb3BtZW50LW9ubHktc2VjcmV0LWNoYW5nZS1tZQ==
